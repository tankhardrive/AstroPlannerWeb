@page "/yearly"
@inject CatalogService CatalogService
@inject SettingsService SettingsService
@inject YearlyStateService YearlyState
@implements IDisposable

<PageTitle>Yearly View — AstroPlanner</PageTitle>

<div class="yearly-page">

    <!-- Controls -->
    <div class="planner-controls">
        <div class="control-group">
            <label>Year</label>
            <input type="number" min="2020" max="2040" value="@_year"
                   @onchange="OnYearChanged" style="width: 80px" />
        </div>
        <div class="control-group">
            <label>Location</label>
            <select value="@_locationName" @onchange="OnLocationChanged">
                @foreach (var loc in (_settings?.Locations ?? []))
                {
                    <option value="@loc.Name">@loc.Name</option>
                }
            </select>
        </div>
        <div class="control-group search-group">
            <input type="search" @bind="_searchText" @bind:event="oninput"
                   @bind:after="ApplyFilter" placeholder="Search objects..." />
            @if (_searchText.Length > 0)
            {
                <button class="search-clear-btn" @onclick="ClearSearch">✕</button>
            }
        </div>
    </div>

    <!-- Type filter chips -->
    <div class="filter-chips">
        <button class="chip @(_activeTypeGroups.Count == 0 ? "chip-active" : "")"
                @onclick="ClearTypeFilter">All</button>
        @foreach (var group in TypeGroups)
        {
            var isActive = _activeTypeGroups.Contains(group.Key);
            <button class="chip @(isActive ? "chip-active" : "")"
                    @onclick="() => ToggleTypeGroup(group.Key, group.Value)">
                @group.Key
            </button>
        }
        <label class="filter-check">
            <input type="checkbox" checked="@_visibleOnly" @onchange="e => { _visibleOnly = (bool)(e.Value ?? true); ApplyFilter(); }" />
            Visible
        </label>
        <label class="filter-check">
            <input type="checkbox" checked="@_imagedOnly" @onchange="e => { _imagedOnly = (bool)(e.Value ?? false); ApplyFilter(); }" />
            Imaged only
        </label>
    </div>

    <!-- Status bar -->
    <div class="status-bar">
        @if (YearlyState.IsComputing)
        {
            <span class="status-loading">Computing… @YearlyState.ProcessedCount / @YearlyState.TotalCount objects</span>
        }
        else
        {
            <span>@_filteredRows.Count objects</span>
        }
    </div>

    <!-- Heatmap table -->
    <div class="yearly-table-wrap">
      <div class="yearly-inner">
        <div class="yearly-list-header">
            <button class="col-hdr @SortClass(-1)" @onclick='() => SortBy(-1)'>Object @SortArrow(-1)</button>
            @for (int m = 0; m < 12; m++)
            {
                var month = m;
                <button class="col-hdr yearly-month-hdr @SortClass(month)" @onclick="() => SortBy(month)">
                    @MonthAbbr[month]@SortArrow(month)
                </button>
            }
        </div>
        <div class="yearly-list-container">
            @if (!YearlyState.IsComputing)
            {
                <Virtualize Items="_filteredRows" Context="row" ItemSize="36">
                    <div class="yearly-row @(_selectedName == row.Object.Name ? "row-selected" : "")"
                         @onclick="() => SelectObject(row.Object.Name)">
                        <span class="col-name">
                            @if (row.Annotation?.IsFavorite == true)
                            {
                                <span class="fav-icon">♥</span>
                            }
                            @if (row.Annotation?.ImagedOn.HasValue == true)
                            {
                                <span class="yearly-imaged">✓</span>
                            }
                            <span>@row.Object.DisplayName</span>
                            @if (row.Object.DisplayName != row.Object.ShortName)
                            {
                                <span class="catalog-ids">@row.Object.ShortName</span>
                            }
                        </span>
                        @for (int m = 0; m < 12; m++)
                        {
                            var s = row.Scores[m];
                            <span class="yearly-cell @VisibilityScorer.ScoreCssClass(s)">@(s > 0 ? ((int)s).ToString() : "–")</span>
                        }
                    </div>
                </Virtualize>
            }
        </div>
      </div>
    </div>

    @if (_selectedName != null)
    {
        <div class="planner-detail-panel">
            <ObjectDetail ObjectName="@_selectedName"
                          OnClose="() => _selectedName = null"
                          OnAnnotationChanged="HandleAnnotationChanged" />
        </div>
    }

</div>

@code {
    AppSettings? _settings;
    string _locationName = "";
    int    _year = DateTime.Today.Year;
    string _searchText = "";
    bool   _visibleOnly = true;
    bool   _imagedOnly;

    readonly HashSet<ObjectType> _activeTypeFilter = [];
    readonly HashSet<string>     _activeTypeGroups  = [];

    int  _sortCol = -1;
    bool _sortAsc = true;

    List<YearlyRow> _filteredRows = [];
    string? _selectedName;

    static readonly string[] MonthAbbr =
        ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

    static readonly Dictionary<string, ObjectType[]> TypeGroups = new()
    {
        ["Galaxy"]    = [ObjectType.Galaxy, ObjectType.GalaxyPair, ObjectType.GalaxyTriplet, ObjectType.GalaxyGroup],
        ["Cluster"]   = [ObjectType.GlobularCluster, ObjectType.OpenCluster, ObjectType.ClusterNebula, ObjectType.StellarAssociation],
        ["Nebula"]    = [ObjectType.EmissionNebula, ObjectType.ReflectionNebula, ObjectType.HiiRegion,
                         ObjectType.BrightNebula, ObjectType.Nebula, ObjectType.DarkNebula],
        ["Planetary"] = [ObjectType.PlanetaryNebula],
        ["SNR"]       = [ObjectType.SupernovaRemnant],
    };

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.LoadAsync();
        _locationName = _settings.ActiveLocationName;
        YearlyState.OnChanged += HandleStateChanged;
        await YearlyState.EnsureComputedAsync(_year, _locationName, _settings, CatalogService);
        if (!YearlyState.IsComputing)
            ApplyFilter();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var y) || y < 2020 || y > 2040) return;
        _year = y;
        await TriggerCompute();
    }

    private async Task OnLocationChanged(ChangeEventArgs e)
    {
        _locationName = e.Value?.ToString() ?? "";
        if (_settings != null)
            _settings.ActiveLocationName = _locationName;
        await TriggerCompute();
    }

    private async Task TriggerCompute()
    {
        _filteredRows = [];
        StateHasChanged();
        await YearlyState.EnsureComputedAsync(_year, _locationName, _settings!, CatalogService);
        if (!YearlyState.IsComputing)
            ApplyFilter();
    }

    private void HandleStateChanged()
    {
        if (!YearlyState.IsComputing)
            ApplyFilter();
        StateHasChanged();
    }

    private void ClearTypeFilter()
    {
        _activeTypeFilter.Clear();
        _activeTypeGroups.Clear();
        ApplyFilter();
    }

    private void ToggleTypeGroup(string label, ObjectType[] types)
    {
        if (_activeTypeGroups.Contains(label))
        {
            _activeTypeGroups.Remove(label);
            foreach (var t in types) _activeTypeFilter.Remove(t);
        }
        else
        {
            _activeTypeGroups.Add(label);
            foreach (var t in types) _activeTypeFilter.Add(t);
        }
        ApplyFilter();
    }

    private void ClearSearch()
    {
        _searchText = "";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _searchText.Trim();
        var filtered = YearlyState.Rows.AsEnumerable();

        if (_activeTypeFilter.Count > 0)
            filtered = filtered.Where(r => _activeTypeFilter.Contains(r.Object.Type));

        if (_visibleOnly)
            filtered = filtered.Where(r => r.Scores.Any(s => s > 0));

        if (_imagedOnly)
            filtered = filtered.Where(r => r.Annotation?.ImagedOn.HasValue == true);

        if (q.Length > 0)
            filtered = filtered.Where(r =>
                r.Object.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (r.Object.CommonName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Object.MessierNumber.HasValue &&
                 $"M{r.Object.MessierNumber}".Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (r.Object.CaldwellNumber.HasValue &&
                 $"C{r.Object.CaldwellNumber}".Contains(q, StringComparison.OrdinalIgnoreCase)));

        _filteredRows = [.. ApplySort(filtered)];
    }

    private IEnumerable<YearlyRow> ApplySort(IEnumerable<YearlyRow> rows) =>
        _sortCol < 0
            ? (_sortAsc ? rows.OrderBy(r => r.Object.DisplayName) : rows.OrderByDescending(r => r.Object.DisplayName))
            : (_sortAsc
                ? rows.OrderBy(r => r.Scores[_sortCol])
                : rows.OrderByDescending(r => r.Scores[_sortCol]));

    private void SortBy(int col)
    {
        if (_sortCol == col)
            _sortAsc = !_sortAsc;
        else
        {
            _sortCol = col;
            _sortAsc = col < 0;
        }
        ApplyFilter();
        StateHasChanged();
    }

    private string SortClass(int col) => _sortCol == col ? "col-hdr-active" : "";
    private string SortArrow(int col)  => _sortCol != col ? "" : _sortAsc ? " ▲" : " ▼";

    private void SelectObject(string name)
        => _selectedName = _selectedName == name ? null : name;

    private async Task HandleAnnotationChanged(string objectName)
    {
        var settings = await SettingsService.LoadAsync();
        settings.Annotations.TryGetValue(objectName, out var ann);
        YearlyState.UpdateAnnotation(objectName, ann);
        ApplyFilter();
    }

    public void Dispose()
        => YearlyState.OnChanged -= HandleStateChanged;
}
